<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>hri_examples</name>
  <version>0.1.0</version>
  <description>Example package for using ROS 2 actions in HRI applications, such as text-to-speech (TTS).</description>
  <maintainer email="rodrigo.perez@urjc.es">Rodrigo Pérez Rodríguez</maintainer>
  <license>Apache-2.0</license>

  <!-- Runtime dependencies -->
  <depend>rclpy</depend>
  <depend>audio_common_msgs</depend>
  <depend>simple_hri_interfaces</depend>
  <depend>nao_lola_command_msgs</depend>
  <depend>nao_pos_interfaces</depend>
  <depend>std_srvs</depend>
  <depend>nao_led_interfaces</depend>
  <depend>hri_client</depend>

  <!-- Test dependencies -->
  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
